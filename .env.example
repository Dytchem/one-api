PORT=3000
DEBUG=false

# 出网代理（可选）：需要走代理访问上游时设置，如 http://127.0.0.1:7890
# 默认不设置（直连）
HTTPS_PROXY=
HTTP_PROXY=

# 会话 cookie 走 HTTPS 时建议开启；开启后同时下发 HSTS
SESSION_COOKIE_SECURE=false

# CORS 允许的来源白名单（逗号分隔），留空则允许任意来源但不带 cookie
ALLOWED_ORIGINS=

# 渠道"获取模型列表"的 SSRF 严格模式：true 时拒绝 RFC1918 私网地址
# 默认 false（one-api 常见部署对接内网 LLM 网关，私网地址合法）
SSRF_BLOCK_PRIVATE=false

# "获取模型列表"专用代理（可选）：该功能默认直连（不走 HTTP_PROXY，保证 SSRF 钉 IP 生效）
# 需要经代理出网时显式设置，如 http://127.0.0.1:7890
FETCH_MODELS_PROXY=

# ============ docker-compose 必需（缺失时 compose 拒绝启动） ============
# 数据库口令：务必设置强随机口令，不要沿用任何示例值
MYSQL_PASSWORD=change-me-strong-password
MYSQL_ROOT_PASSWORD=change-me-root-password
# 数据库连接串（默认使用上面两个口令拼出，可整体覆盖）
# MYSQL_DSN=oneapi:YOUR_PASSWORD@tcp(db:3306)/one-api

# pi-bridge 共享密钥：one-api 与 bridge 之间调用鉴权（与 bridge 的 BRIDGE_SECRET 同值）
# 生成：openssl rand -hex 32
AGENT_BRIDGE_SECRET=
# pi-bridge 服务地址（compose 内默认 host.docker.internal:3005；宿主机直跑时无需改）
# AGENT_BRIDGE_URL=http://127.0.0.1:3005
